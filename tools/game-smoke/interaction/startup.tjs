// Self-contained UI contract fixture; never installed in a commercial game.
global.events = [];
global.inputProbe = false;
global.lifecycleProbe = false;
global.pointerProbe = false;
global.record = function(text) {
    events.add(text);
    events.save(System.exePath + "interaction-events.txt");
};
System.onActivate = function() {
    if(lifecycleProbe) record("lifecycle:activate");
};
System.onDeactivate = function() {
    if(lifecycleProbe) record("lifecycle:deactivate");
};
class ContractWindow extends Window {
    var allowClose = false;
    var closeQueries = 0;
    var pointerName = "";
    var pointerHeld = false;
    function ContractWindow() {
        super.Window();
        caption = "KrKr2 window contract";
        setSize(640, 480);
        visible = true;
    }
    function onCloseQuery() {
        ++closeQueries;
        record("close-query:" + string allowClose);
        super.onCloseQuery(allowClose);
    }
    function onKeyDown(key, shift) {
        record("key:" + string key);
        if(inputProbe) {
            var current = System.getKeyState(key, true);
            var pressed = System.getKeyState(key, false);
            record("input:key-down:" + string key + ":" + string shift + ":" + string current + ":" + string pressed);
        }
    }
    function onKeyUp(key, shift) {
        if(inputProbe) {
            var current = System.getKeyState(key, true);
            var pressed = System.getKeyState(key, false);
            record("input:key-up:" + string key + ":" + string shift + ":" + string current + ":" + string pressed);
        }
    }
    function onMouseDown(x, y, button, shift) {
        pointerHeld = true;
        if(pointerProbe) record("pointer:" + pointerName + "down:" + string button);
    }
    function onMouseUp(x, y, button, shift) {
        pointerHeld = false;
        if(pointerProbe) record("pointer:" + pointerName + "up:" + string button);
    }
    function onClick(x, y) {
        if(pointerProbe) record("pointer:" + pointerName + "click");
    }
}
class ContractMenu extends MenuItem {
    function ContractMenu(owner) {
        super.MenuItem(owner, "Contract toggle");
    }
    function onClick() {
        checked = !checked;
        record("menu-click:" + string checked);
    }
}
global.win = new ContractWindow();
global.primary = new Layer(win, null);
primary.setSize(640, 480);
primary.fillRect(0, 0, 640, 480, 0xff304050);
primary.visible = true;
global.entry = new ContractMenu(win);
win.menu.add(entry);
global.lastCommand = "";
global.driver = new Timer(function() {
    try {
        if(!Storages.isExistentStorage(System.exePath + "interaction-command.txt")) return;
        var command = [];
        command.load(System.exePath + "interaction-command.txt");
        if(!command.count || command[0] == lastCommand) return;
        lastCommand = command[0];
        record("command:" + lastCommand);
        if(lastCommand == "pointer-probe") {
            pointerProbe = true;
            record("pointer-probe-ready");
        } else if(lastCommand == "pointer-windows") {
            pointerProbe = true;
            win.pointerName = "a:";
            global.peer = new ContractWindow();
            peer.pointerName = "b:";
            global.peerLayer = new Layer(peer, null);
            peerLayer.setSize(640, 480);
            peerLayer.fillRect(0, 0, 640, 480, 0xff506030);
            peerLayer.visible = true;
            win.bringToFront();
            record("pointer-windows-ready");
        } else if(lastCommand == "pointer-switch-b") {
            peer.bringToFront();
            record("pointer-window-b");
        } else if(lastCommand == "pointer-invalidate-b") {
            invalidate peer;
            record("pointer-window-b-invalidated");
        } else if(lastCommand == "pointer-b-held") {
            if(!peer.pointerHeld || !System.getKeyState(1, true))
                throw new Exception("Old A touch released B drag");
            record("pointer-window-b-held");
        } else if(lastCommand == "pointer-a-held") {
            if(!win.pointerHeld || !System.getKeyState(1, true))
                throw new Exception("Old B touch released A drag");
            record("pointer-window-a-held");
        } else if(lastCommand == "pointer-hide") {
            win.visible = false;
            record("pointer-hidden");
        } else if(lastCommand == "pointer-show") {
            win.visible = true;
            record("pointer-shown");
        } else if(lastCommand == "lifecycle-probe") {
            lifecycleProbe = true;
            record("lifecycle-probe-ready");
        } else if(lastCommand == "lifecycle-probe-end") {
            lifecycleProbe = false;
            record("lifecycle-probe-done");
        } else if(lastCommand == "keyboard-probe") {
            inputProbe = true;
            record("keyboard-probe-ready");
        } else if(lastCommand == "keyboard-probe-end") {
            inputProbe = false;
            record("keyboard-probe-done");
        } else if(lastCommand == "inform") {
            var answer = System.inform("Acknowledge the window contract test.", "KrKr2 contract message", ["OK"]);
            record("inform-return:" + string answer);
        } else if(lastCommand == "select-cancel" || lastCommand == "select-accept") {
            var params = %[title:"KrKr2 contract file", initialDir:System.exePath, name:"fixture.txt", save:false];
            var accepted = Storages.selectFile(params);
            record(lastCommand + "-return:" + string accepted);
            record(lastCommand + "-name:" + string params.name);
        } else if(lastCommand == "menu-open" || lastCommand == "menu-open-again") {
            win.menu.popup(0, 0, 0);
            record("menu-opened");
        } else if(lastCommand == "veto") {
            win.allowClose = false;
            win.close();
            if(win.closeQueries != 1 || !win.visible) throw new Exception("Veto did not preserve window");
            record("veto-preserved");
        } else if(lastCommand == "accept") {
            win.allowClose = true;
            win.close();
            record("close-returned");
        } else if(lastCommand == "finish") {
            record("fixture-finished");
            System.exit();
        }
    } catch(e) {
        record("error:" + e.message);
        driver.enabled = false;
    }
}, "");
driver.interval = 300;
driver.enabled = true;
record("ready");
