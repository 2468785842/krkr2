// Self-authored fixture using the game runtime's regular native classes.
global.events = [];
global.record = function(text) {
    events.add(text);
    events.save(System.exePath + "interaction-events.txt");
};

class HostWindow extends Window {
    var closeQueries = 0;
    function HostWindow() {
        super.Window();
        caption = "KrKr2 SDL3 runtime contract";
        setPos(120, 160);
        setMinSize(160, 120);
        setMaxSize(900, 600);
        setSize(320, 240);
    }
    function onKeyDown(key, shift) {
        if(key == 65) {
            scene.colorRect(0, 0, 160, 120, 0xd03020, 255);
            record("key-down:" + key + ":" + string System.getKeyState(key, true));
        }
        if(key == 113) {
            imeMode = imClose;
            record("ime:closed");
        }
        if(key == 114) {
            imeMode = imOpen;
            record("ime:open");
        }
        if(key == 115) {
            setZoom(6, 4);
            record("zoom:" + zoomNumer + ":" + zoomDenom);
        }
        if(key == 116) {
            visible = false;
            showAgain.enabled = true;
            record("visibility:hidden");
        }
        if(key == 117) {
            var peer = new ModalWindow();
            var peerLayer = new Layer(peer, null);
            peerLayer.setSize(160, 120);
            peerLayer.setImageSize(160, 120);
            peerLayer.type = ltOpaque;
            peerLayer.colorRect(0, 0, 160, 120, 0x8040a0, 255);
            peerLayer.visible = true;
            record("modal:opening");
            peer.showModal();
            record("modal:returned:" + string peer.visible);
            invalidate peer;
        }
        if(key == 88)
            record("main:key-x");
    }
    function onKeyUp(key, shift) {
        if(key == 65)
            record("key-up:" + key + ":" + string System.getKeyState(key, true));
    }
    function onKeyPress(key) { record("text:" + string (#key)); }
    function onResize() { record("resize:" + width + ":" + height); }
    function onActivate() { record("window:active"); }
    function onDeactivate() { record("window:inactive"); }
    function onMouseMove(x, y, shift) {
        if(x < 0 || x >= 320 || y < 0 || y >= 240)
            record("drag-outside:" + x + ":" + y);
    }
    function onClick(x, y) { record("click:" + x + ":" + y); }
    function onDoubleClick(x, y) { record("double-click:" + x + ":" + y); }
    function onMouseWheel(shift, delta, x, y) {
        record("wheel:" + delta + ":" + x + ":" + y);
    }
    function onMouseDown(x, y, button, shift) {
        if(button != mbLeft) {
            record("button-down:" + button + ":" + x + ":" + y);
            return;
        }
        scene.colorRect(160, 0, 160, 120, 0x30c050, 255);
        record("mouse-down:" + x + ":" + y + ":" + string System.getKeyState(1, true));
    }
    function onMouseUp(x, y, button, shift) {
        if(button != mbLeft) {
            record("button-up:" + button + ":" + x + ":" + y);
            return;
        }
        record("mouse-up:" + x + ":" + y + ":" + string System.getKeyState(1, true));
    }
    function onCloseQuery() {
        ++closeQueries;
        record("close:" + closeQueries);
        super.onCloseQuery(closeQueries > 1);
    }
}

class ModalWindow extends Window {
    var closeQueries = 0;
    function ModalWindow() {
        super.Window();
        caption = "KrKr2 SDL3 modal contract";
        setPos(780, 160);
        setSize(160, 120);
    }
    function onCloseQuery() {
        ++closeQueries;
        record("modal-close:" + closeQueries);
        super.onCloseQuery(closeQueries > 1);
    }
    function onKeyDown(key, shift) {
        if(key == 88)
            record("modal:key-x");
    }
}

global.win = new HostWindow();
win.visible = true;
global.showAgain = new Timer(function() {
    showAgain.enabled = false;
    win.visible = true;
    record("visibility:shown");
}, "");
showAgain.interval = 750;
global.scene = new Layer(win, null);
scene.setImageSize(320, 240);
scene.setSize(320, 240);
scene.type = ltOpaque;
scene.colorRect(0, 0, 320, 240, 0x204060, 255);
scene.visible = true;
win.imeMode = imOpen;
record("limits:" + win.minWidth + ":" + win.minHeight + ":" + win.maxWidth + ":" + win.maxHeight);
System.onActivate = function() { record("system:active"); };
System.onDeactivate = function() { record("system:inactive"); };
record("ready");
