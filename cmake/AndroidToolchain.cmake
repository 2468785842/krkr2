# Gradle passes the NDK toolchain and ABI. Use vcpkg as the outer toolchain.
if(ANDROID_ABI STREQUAL "arm64-v8a")
    set(VCPKG_TARGET_TRIPLET arm64-android)
elseif(ANDROID_ABI STREQUAL "x86_64")
    set(VCPKG_TARGET_TRIPLET x64-android)
else()
    message(FATAL_ERROR "Android requires ANDROID_ABI=arm64-v8a or x86_64")
endif()

if(NOT EXISTS "$ENV{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake")
    message(FATAL_ERROR "Set VCPKG_ROOT to a bootstrapped vcpkg checkout")
endif()
if(KRKR2_TOOLCHAIN_NAME STREQUAL "android.toolchain.cmake")
    set(VCPKG_CHAINLOAD_TOOLCHAIN_FILE "${CMAKE_TOOLCHAIN_FILE}")
elseif(NOT VCPKG_CHAINLOAD_TOOLCHAIN_FILE)
    set(VCPKG_CHAINLOAD_TOOLCHAIN_FILE "$ENV{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake")
endif()
if(NOT EXISTS "${VCPKG_CHAINLOAD_TOOLCHAIN_FILE}")
    message(FATAL_ERROR "Android requires an NDK toolchain from Gradle or ANDROID_NDK_HOME")
endif()
set(VCPKG_CHAINLOAD_TOOLCHAIN_FILE "${VCPKG_CHAINLOAD_TOOLCHAIN_FILE}" CACHE FILEPATH
    "NDK toolchain used by the Android manifest build" FORCE)
get_filename_component(KRKR2_NDK_TOOLCHAIN_DIR "${VCPKG_CHAINLOAD_TOOLCHAIN_FILE}" DIRECTORY)
get_filename_component(KRKR2_NDK_ROOT "${KRKR2_NDK_TOOLCHAIN_DIR}/../.." ABSOLUTE)
set(ENV{ANDROID_NDK_HOME} "${KRKR2_NDK_ROOT}")
set(CMAKE_TOOLCHAIN_FILE "$ENV{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake")
