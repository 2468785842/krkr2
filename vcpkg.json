{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "krkr2",
  "version-string": "1.5.0",
  "overrides": [
    {
      "name": "opencv4",
      "version": "4.7.0",
      "port-version": 6
    }
  ],
  "features": {
    "engine": {
      "description": "Complete runtime and bundled plugins",
      "dependencies": [
        "7zip",
        {
          "name": "blend2d",
          "platform": "!windows"
        },
        {
          "name": "breakpad",
          "default-features": false,
          "platform": "android"
        },
        {
          "name": "cocos2dx",
          "default-features": false,
          "features": [
            "ui",
            "archive",
            "extensions",
            "desktop"
          ]
        },
        "ffmpeg",
        "glm",
        "jxrlib",
        "libarchive",
        "libxml2",
        "libjpeg-turbo",
        {
          "name": "libogg",
          "platform": "android"
        },
        {
          "name": "libpng",
          "platform": "!linux"
        },
        "libvorbis",
        "libwebp",
        "lz4",
        {
          "name": "miniaudio",
          "platform": "android"
        },
        "openal-soft",
        {
          "name": "opencv4",
          "default-features": false,
          "features": [
            "openmp"
          ]
        },
        {
          "name": "opus",
          "platform": "android"
        },
        {
          "name": "opusfile",
          "default-features": false
        },
        "uchardet",
        "unrar",
        {
          "name": "vcpkg-cmake",
          "host": true
        },
        "zstd",
        {
          "name": "dirent",
          "platform": "windows"
        },
        "zlib"
      ]
    },
    "tests": {
      "description": "Desktop Catch2 test framework",
      "dependencies": [
        {
          "name": "catch2",
          "default-features": false,
          "platform": "!android & !ios"
        }
      ]
    },
    "tools": {
      "description": "Command-line tools",
      "dependencies": [
        {
          "name": "argparse",
          "platform": "linux | windows | osx"
        },
        "zlib"
      ]
    },
    "psd": {
      "description": "PSD layered image plugin",
      "dependencies": [
        "boost-iostreams",
        "boost-phoenix",
        "boost-spirit"
      ]
    },
    "crash-upload": {
      "description": "Optional crash report upload via cocos networking",
      "dependencies": [
        {
          "name": "cocos2dx",
          "default-features": false,
          "features": [
            "network"
          ]
        }
      ]
    },
    "archives": {
      "description": "Headless ZIP archive validation",
      "dependencies": [
        "zlib"
      ]
    },
    "foundation": {
      "description": "TJS, logging and shared archive foundations",
      "dependencies": [
        {
          "name": "boost-locale",
          "default-features": false
        },
        "fmt",
        "oniguruma",
        "spdlog"
      ]
    },
    "imageops": {
      "description": "CPU image operations without the runtime or window backend",
      "dependencies": [
        {
          "name": "opencv4",
          "default-features": false,
          "features": [
            "openmp"
          ]
        }
      ]
    }
  },
  "default-features": [
    "foundation"
  ]
}
