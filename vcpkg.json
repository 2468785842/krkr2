{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "krkr2",
  "version-string": "1.5.0",
  "features": {
    "sdl3": {
      "description": "SDL3 window and input dependencies",
      "dependencies": [
        {
          "name": "sdl3",
          "platform": "!linux"
        },
        {
          "name": "sdl3",
          "platform": "linux",
          "features": [
            "dbus",
            "libdecor"
          ]
        }
      ]
    },
    "engine": {
      "description": "Complete runtime and bundled plugins",
      "dependencies": [
        "7zip",
        {
          "name": "blend2d",
          "platform": "!windows"
        },
        "ffmpeg",
        "freetype",
        {
          "name": "glew",
          "platform": "linux | windows"
        },
        "jxrlib",
        "libarchive",
        "nlohmann-json",
        "pugixml",
        "libjpeg-turbo",
        "libpng",
        "libvorbis",
        {
          "name": "libwebp",
          "default-features": false,
          "features": [
            "simd"
          ]
        },
        "lz4",
        "openal-soft",
        {
          "name": "opengl",
          "platform": "linux"
        },
        {
          "name": "opusfile",
          "default-features": false
        },
        "uchardet",
        "unrar",
        {
          "name": "vcpkg-cmake",
          "host": true
        },
        "zstd",
        "xxhash",
        {
          "name": "dirent",
          "platform": "windows"
        },
        "zlib"
      ]
    },
    "tests": {
      "description": "Desktop Catch2 test framework",
      "dependencies": [
        {
          "name": "catch2",
          "default-features": false,
          "platform": "!android & !ios"
        }
      ]
    },
    "tools": {
      "description": "Command-line tools",
      "dependencies": [
        {
          "name": "argparse",
          "platform": "linux | windows | osx"
        },
        "zlib"
      ]
    },
    "psd": {
      "description": "PSD layered image plugin",
      "dependencies": [
        "boost-iostreams",
        "boost-phoenix",
        "boost-spirit"
      ]
    },
    "archives": {
      "description": "Headless ZIP archive validation",
      "dependencies": [
        "zlib"
      ]
    },
    "foundation": {
      "description": "TJS, logging and shared archive foundations",
      "dependencies": [
        {
          "name": "boost-locale",
          "default-features": false
        },
        "fmt",
        "oniguruma",
        "spdlog",
        "frozen",
        "utf8proc"
      ]
    },
    "config": {
      "description": "JSON configuration, legacy XML migration and native host resources without the game runtime",
      "dependencies": [
        "nlohmann-json",
        "pugixml"
      ]
    },
    "imageops": {
      "description": "CPU image operations without the runtime or window backend",
      "dependencies": []
    },
    "native-dialogs": {
      "description": "Linux GTK native dialogs for the production SDL3 host",
      "dependencies": [
        {
          "name": "gtk3",
          "features": [
            "wayland"
          ],
          "platform": "linux"
        }
      ]
    }
  },
  "default-features": [
    "foundation"
  ],
  "supports": "windows | linux"
}
