{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "Windows Config",
      "generator": "Ninja",
      "hidden": true,
      "cacheVariables": {
        "WINDOWS": true,
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "hostOS": [
            "Windows"
          ]
        }
      }
    },
    {
      "name": "Windows Debug Config",
      "inherits": "Windows Config",
      "binaryDir": "${sourceDir}/out/windows/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "Windows Release Config",
      "inherits": "Windows Config",
      "binaryDir": "${sourceDir}/out/windows/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "Windows SDL3 Debug Config",
      "inherits": "Windows Debug Config",
      "binaryDir": "${sourceDir}/out/windows/sdl3-debug",
      "cacheVariables": {
        "KRKR2_SDL3_ONLY": true,
        "ENABLE_TESTS": true,
        "KRKR2_TEST_SCOPE": "platform",
        "BUILD_TOOLS": false,
        "KRKR2_ENABLE_UI_TEST_DRIVER": false
      }
    },
    {
      "name": "Windows SDL3 Release Config",
      "inherits": "Windows SDL3 Debug Config",
      "binaryDir": "${sourceDir}/out/windows/sdl3-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_DISABLE_FIND_PACKAGE_cocos2dx": true
      }
    },
    {
      "name": "Windows XP3 Config",
      "inherits": "Windows Debug Config",
      "binaryDir": "${sourceDir}/out/windows/xp3",
      "cacheVariables": {
        "KRKR2_BUILD_APP": false,
        "ENABLE_TESTS": false,
        "BUILD_TOOLS": true
      }
    },
    {
      "name": "Windows Strings Config",
      "inherits": "Windows Debug Config",
      "binaryDir": "${sourceDir}/out/windows/strings",
      "cacheVariables": {
        "KRKR2_BUILD_APP": false,
        "ENABLE_TESTS": true,
        "BUILD_TOOLS": false,
        "KRKR2_TEST_SCOPE": "strings"
      }
    },
    {
      "name": "Windows Lean Debug Config",
      "inherits": "Windows Debug Config",
      "binaryDir": "${sourceDir}/out/windows/lean-debug",
      "cacheVariables": {
        "KRKR2_BUILD_APP": true,
        "ENABLE_TESTS": false,
        "BUILD_TOOLS": false,
        "KRKR2_ENABLE_PSD": false,
        "KRKR2_ENABLE_CRASH_UPLOAD": false
      }
    },
    {
      "name": "Windows MinGW Config",
      "generator": "Ninja",
      "hidden": true,
      "cacheVariables": {
        "WINDOWS": true,
        "CMAKE_SYSTEM_NAME": "Windows",
        "CMAKE_C_COMPILER": "i686-w64-mingw32-gcc",
        "CMAKE_CXX_COMPILER": "i686-w64-mingw32-g++",
        "CMAKE_RC_COMPILER": "i686-w64-mingw32-windres",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "Linux Config",
      "generator": "Ninja",
      "hidden": true,
      "cacheVariables": {
        "LINUX": true,
        "CMAKE_EXPORT_COMPILE_COMMANDS": true
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "Linux Debug Config",
      "inherits": "Linux Config",
      "binaryDir": "${sourceDir}/out/linux/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "Linux Release Config",
      "inherits": "Linux Config",
      "binaryDir": "${sourceDir}/out/linux/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "Linux SDL3 Config",
      "inherits": "Linux Release Config",
      "binaryDir": "${sourceDir}/out/linux/sdl3",
      "cacheVariables": {
        "CMAKE_DISABLE_FIND_PACKAGE_cocos2dx": true,
        "ENABLE_TESTS": true,
        "BUILD_TOOLS": false,
        "KRKR2_ENABLE_SCRIPT_SMOKE": true,
        "KRKR2_ENABLE_UI_TEST_DRIVER": false,
        "KRKR2_SDL3_ONLY": true
      }
    },
    {
      "name": "MacOS Config",
      "generator": "Ninja",
      "hidden": true,
      "cacheVariables": {
        "MACOS": true,
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "MacOS Debug Config",
      "inherits": "MacOS Config",
      "binaryDir": "${sourceDir}/out/macos/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "MacOS Release Config",
      "inherits": "MacOS Config",
      "binaryDir": "${sourceDir}/out/macos/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "Windows SDL3 Debug Build",
      "configurePreset": "Windows SDL3 Debug Config",
      "targets": [
        "krkr2",
        "input_state_tests",
        "frame_hook_tests",
        "main_thread_message_tests",
        "texture_presentation_tests",
        "launch_tests",
        "pvrtc_decoder_tests"
      ]
    },
    {
      "name": "Windows XP3 Build",
      "configurePreset": "Windows XP3 Config",
      "targets": [
        "xp3"
      ]
    },
    {
      "name": "Windows Strings Build",
      "configurePreset": "Windows Strings Config",
      "targets": [
        "tjsString"
      ]
    },
    {
      "name": "Windows Lean Debug Build",
      "configurePreset": "Windows Lean Debug Config",
      "targets": [
        "krkr2"
      ]
    },
    {
      "name": "Windows Debug Build",
      "configurePreset": "Windows Debug Config"
    },
    {
      "name": "Windows Release Build",
      "configurePreset": "Windows Release Config"
    },
    {
      "name": "Linux Debug Build",
      "configurePreset": "Linux Debug Config"
    },
    {
      "name": "Linux Release Build",
      "configurePreset": "Linux Release Config"
    },
    {
      "name": "MacOS Debug Build",
      "configurePreset": "MacOS Debug Config"
    },
    {
      "name": "MacOS Release Build",
      "configurePreset": "MacOS Release Config"
    },
    {
      "name": "Windows SDL3 Release Build",
      "configurePreset": "Windows SDL3 Release Config"
    }
  ]
}
